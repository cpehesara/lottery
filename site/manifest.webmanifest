{
  "name": "Lottery Results Printer",
  "short_name": "Lottery Print",
  "description": "Put the day's lottery results on one A4 sheet, three copies, ready to print.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e7ece9",
  "theme_color": "#0b5d47",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "image", "accept": ["image/*"] } ] }
  }
}
